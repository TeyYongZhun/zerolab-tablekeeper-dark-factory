# Featherless API key. OpenCode reads it via {env:FEATHERLESS_API_KEY} in
# ~/.config/opencode/opencode.json, so export it in the shell that runs `opencode serve`.
FEATHERLESS_API_KEY=

# OpenCode server the seats talk to (default http://127.0.0.1:4096)
# OPENCODE_BASE_URL=

# Architect Seat Credentials
BAND_ARCHITECT_AGENT_ID=
BAND_ARCHITECT_API_KEY=

# QA Lead Seat Credentials
BAND_QA_LEAD_AGENT_ID=
BAND_QA_LEAD_API_KEY=

# Shared: absolute WSL path to the result repository every seat works in.
# The Developer is Band-hosted (Claude Code) and needs no credentials here.
RESULT_REPO=
